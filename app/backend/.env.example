# -----------------------------------------------------------------------------
# charlyHB Application Environment Configuration
# -----------------------------------------------------------------------------

# Application Basics
APP_NAME=charlyHB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Client Origins & CORS (Add your frontend development/production origin here)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Localization & Faking
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Connection Options
# -----------------------------------------------------------------------------

# Option 1: SQLite (Recommended for rapid local dev & test suite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Option 2: MySQL / MariaDB (Standard for production & staging)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=stock_meuve
# DB_USERNAME=root
# DB_PASSWORD=

# Option 3: PostgreSQL (Cloud deployments e.g., Render, Neon, Supabase)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=stock_meuve
# DB_USERNAME=postgres
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session & Cache Storage
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail Configuration (Defaults to 'log' driver for local development)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@charlyhb.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Performance & Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
